        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam linetype ortho\nskinparam nodesep 60\nskinparam ranksep 80\nhide circle\n\ntogether {\n  class Student\n  class CommitteeMember\n  class Warden\n  class Contractor\n  class Administrator\n}\n\ntogether {\n  class Menu\n  class MenuItem\n  class Rating\n  class RebateApplication\n  class Complaint\n}\n\ntogether {\n  class Poll\n  class PollOption\n  class Vote\n  class Report\n  class Notification\n}\n\nabstract class User {\n  - userId : String\n  - name : String\n  - email : String\n  - passwordHash : String\n  - role : Role\n  - isActive : Boolean\n  + login(id, password) : Boolean\n  + logout() : void\n  + changePassword(old, new) : Boolean\n  + getRole() : Role\n}\n\nclass Student {\n  - rollNo : String\n  - hostelBlock : String\n  - roomNo : String\n  - messId : String\n  + viewMenu(date, meal) : Menu\n  + submitRating(menu, score, comment) : Rating\n  + applyRebate(start, end, reason) : RebateApplication\n  + registerComplaint(category, desc) : Complaint\n  + castVote(poll, option) : Vote\n}\n\nclass CommitteeMember {\n  - memberId : String\n  - tenureStart : Date\n  - tenureEnd : Date\n  + publishMenu(date, meal, items) : Menu\n  + reviseMenu(menu, items) : Menu\n  + updateComplaintStatus(c, status, remark) : void\n  + createPoll(question, options, close) : Poll\n  + generateReport(type, from, to) : Report\n}\n\nclass Warden {\n  - employeeId : String\n  + viewPendingApplications() : List\n  + approveRebate(app, days, remark) : void\n  + rejectRebate(app, remark) : void\n}\n\nclass Contractor {\n  - contractorId : String\n  - organisation : String\n  - contactNo : String\n  + viewReport(report) : Report\n}\n\nclass Administrator {\n  - adminId : String\n  + createAccount(details, role) : User\n  + deactivateAccount(user) : void\n  + assignRole(user, role) : void\n}\n\nclass Menu {\n  - menuId : String\n  - date : Date\n  - mealType : MealType\n  - publishedOn : DateTime\n  - version : Integer\n  - status : MenuStatus\n  + addItem(item) : void\n  + removeItem(item) : void\n  + revise(items) : Menu\n  + withdraw() : void\n  + getAverageRating() : Float\n}\n\nclass MenuItem {\n  - itemId : String\n  - name : String\n  - category : String\n  - isVegetarian : Boolean\n  + getAverageRating(from, to) : Float\n}\n\nclass Rating {\n  - ratingId : String\n  - score : Integer\n  - comment : String\n  - submittedOn : DateTime\n  + submit() : Boolean\n  + isDuplicate(student, menu) : Boolean\n}\n\nclass RebateApplication {\n  - applicationId : String\n  - startDate : Date\n  - endDate : Date\n  - reason : String\n  - daysClaimed : Integer\n  - daysApproved : Integer\n  - status : ApplicationStatus\n  - appliedOn : DateTime\n  - decidedOn : DateTime\n  - decisionRemark : String\n  + submit() : Boolean\n  + calculateDays() : Integer\n  + validateNotice() : Boolean\n  + approve(days, remark, by) : void\n  + reject(remark, by) : void\n  + withdraw() : void\n}\n\nclass Complaint {\n  - complaintId : String\n  - category : String\n  - description : String\n  - photoPath : String\n  - status : ComplaintStatus\n  - registeredOn : DateTime\n  - handledBy : String\n  - remark : String\n  - resolvedOn : DateTime\n  + register() : String\n  + updateStatus(status, remark, by) : void\n  + getStatus() : ComplaintStatus\n}\n\nclass Poll {\n  - pollId : String\n  - question : String\n  - createdOn : DateTime\n  - closingDate : Date\n  - status : PollStatus\n  - actionTaken : String\n  + create() : void\n  + close() : void\n  + computeResult() : PollOption\n  + isOpen() : Boolean\n}\n\nclass PollOption {\n  - optionId : String\n  - optionText : String\n  + getVoteCount() : Integer\n}\n\nclass Vote {\n  - voteId : String\n  - castOn : DateTime\n  + cast() : Boolean\n  + isDuplicate(student, poll) : Boolean\n}\n\nclass Report {\n  - reportId : String\n  - type : ReportType\n  - periodStart : Date\n  - periodEnd : Date\n  - generatedOn : DateTime\n  + generate() : void\n  + export(format) : File\n  + getSummary() : String\n}\n\nclass Notification {\n  - notificationId : String\n  - message : String\n  - sentOn : DateTime\n  - isRead : Boolean\n  + send() : Boolean\n  + markRead() : void\n}\n\nUser &lt;|-- Student\nUser &lt;|-- CommitteeMember\nUser &lt;|-- Warden\nUser &lt;|-- Contractor\nUser &lt;|-- Administrator\n\nCommitteeMember \&quot;1\&quot; -- \&quot;0..*\&quot; Menu : publishes\nMenu \&quot;0..*\&quot; -- \&quot;1..*\&quot; MenuItem : contains\nStudent \&quot;1\&quot; -- \&quot;0..*\&quot; Rating : submits\nMenu \&quot;1\&quot; -- \&quot;0..*\&quot; Rating : receives\nStudent \&quot;1\&quot; -- \&quot;0..*\&quot; RebateApplication : submits\nWarden \&quot;1\&quot; -- \&quot;0..*\&quot; RebateApplication : decides\nStudent \&quot;1\&quot; -- \&quot;0..*\&quot; Complaint : registers\nCommitteeMember \&quot;1\&quot; -- \&quot;0..*\&quot; Complaint : handles\nComplaint \&quot;0..*\&quot; -- \&quot;0..1\&quot; Menu : concerns\nCommitteeMember \&quot;1\&quot; -- \&quot;0..*\&quot; Poll : creates\nPoll \&quot;1\&quot; *-- \&quot;2..*\&quot; PollOption : offers\nStudent \&quot;1\&quot; -- \&quot;0..*\&quot; Vote : casts\nPollOption \&quot;1\&quot; -- \&quot;0..*\&quot; Vote : receives\nCommitteeMember \&quot;1\&quot; -- \&quot;0..*\&quot; Report : generates\nContractor \&quot;1\&quot; -- \&quot;0..*\&quot; Report : views\nUser \&quot;1\&quot; -- \&quot;0..*\&quot; Notification : receives\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="WmWGejRxZhybWBCetA42-1">
